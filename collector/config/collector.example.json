{
    "_comment": "Collector configuration. Values here serve as defaults; override with AGENTIC_GOV_* env vars or CLI flags. Precedence: CLI > env > this file > code defaults.",
    "config_version": 1,

    "output": "./scan-results.ndjson",
    "endpoint_id": null,
    "actor_id": null,
    "sensitivity": "Tier0",

    "network_allowlist_path": null,

    "interval": 0,
    "api_url": null,
    "api_key": null,
    "report_all": false,

    "protocol": "auto",
    "gateway_host": null,
    "gateway_port": 8001,
    "tcp_connect_timeout_seconds": 3,
    "tcp_retry_interval_seconds": 30,
    "tcp_failure_threshold": 5,
    "tcp_recovery_stability_seconds": 10,

    "verbose": false,
    "dry_run": false,

    "approval_hold": {
        "poll_interval_seconds": 10,
        "timeout_seconds": 300,
        "timeout_behavior": "deny",
        "offline_behavior": "deny"
    },

    "enforcement": {
        "protected_parents": [],
        "allow_persistent_disable": false,
        "require_corroboration": true
    }
