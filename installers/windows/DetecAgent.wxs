<?xml version="1.0" encoding="UTF-8"?>
<!--
  Detec Agent - WiX v4+ MSI Definition

  Key behaviours:
    - Installs full PyInstaller dist to %ProgramFiles%\Detec\Agent (64-bit)
    - Writes agent.env to %ProgramData%\Detec\Agent\ via the agent's write-env command
    - Registers a Scheduled Task (DetecAgent) to run at system startup under SYSTEM
    - GUI tray app registered via ActiveSetup (runs once per-user at first logon)
    - MajorUpgrade: downgrades blocked

  Build (3 steps):
    1. Build PyInstaller dist dirs (pyinstaller detec-agent.spec / detec-agent-gui.spec)
    2. Harvest the _internal dirs into WiX fragments:
         wix heat dir dist\detec-agent\_internal -cg AgentInternalFiles -dr AGENTINTERNALDIR ^
           -var var.AgentInternalDir -ag -sfrag -srd -o AgentInternal.wxs
         wix heat dir dist\detec-agent-gui\_internal -cg GuiInternalFiles -dr GUIINTERNALDIR ^
           -var var.GuiInternalDir -ag -sfrag -srd -o GuiInternal.wxs
    3. Build MSI:
         wix build DetecAgent.wxs AgentInternal.wxs GuiInternal.wxs ^
           -d AgentInternalDir=dist\detec-agent\_internal ^
           -d GuiInternalDir=dist\detec-agent-gui\_internal ^
           -o dist\DetecAgent.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Detec Agent"
    Manufacturer="Detec"
    Version="1.0.0"
    UpgradeCode="E8A1F2C3-4D56-7890-ABCD-EF1234567890">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Detec Agent is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Properties stamped by server at download time (trailer appended by msi_stamper) -->
    <Property Id="DETEC_API_URL" Value="PLACEHOLDER" Secure="yes" />
    <Property Id="DETEC_API_KEY" Value="PLACEHOLDER" Secure="yes" Hidden="yes" />
    <Property Id="DETEC_TENANT_ID" Value="PLACEHOLDER" Secure="yes" />

    <!-- Directory layout — ProgramFiles64Folder ensures C:\Program Files\ on 64-bit -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Detec">
        <Directory Id="AGENTFOLDER" Name="Agent">

          <!-- Main agent exe (explicit, so we can reference it from custom actions) -->
          <Component Id="AgentExe" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567891">
            <File Id="DetecAgentExe" Source="dist\detec-agent\detec-agent.exe" KeyPath="yes" />
          </Component>

          <!-- PyInstaller dependencies (harvested) -->
          <Directory Id="AGENTINTERNALDIR" Name="_internal">
            <!-- AgentInternalFiles component group injected by wix heat -->
          </Directory>

          <!-- GUI tray application -->
          <Directory Id="GUIFOLDER" Name="Agent-GUI">
            <Component Id="GuiExe" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567892">
              <File Id="DetecAgentGuiExe" Source="dist\detec-agent-gui\detec-agent-gui.exe" KeyPath="yes" />
            </Component>
            <Directory Id="GUIINTERNALDIR" Name="_internal">
              <!-- GuiInternalFiles component group injected by wix heat -->
            </Directory>
          </Directory>

          <!-- Branding assets -->
          <Directory Id="BRANDINGFOLDER" Name="branding">
            <Component Id="BrandingFiles" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567893">
              <File Id="IconIco" Source="..\..\branding\Icon.ico" KeyPath="yes" />
              <File Id="IconPng" Source="..\..\branding\Icon.png" />
            </Component>
          </Directory>

        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- ProgramData directory for config (agent.env) -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DETECDATADIR" Name="Detec">
        <Directory Id="AGENTDATADIR" Name="Agent">
          <Component Id="AgentDataDir" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567894">
            <CreateFolder />
            <RegistryValue Root="HKLM" Key="SOFTWARE\Detec\Agent" Name="DataDir"
              Type="string" Value="[AGENTDATADIR]" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- ActiveSetup: launch tray app once per user at first logon -->
    <Component Id="ActiveSetupTray" Directory="AGENTFOLDER" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567897">
      <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Active Setup\Installed Components\DetecAgentTray">
        <RegistryValue Type="string" Value="Detec Agent Tray" KeyPath="yes" />
        <RegistryValue Name="StubPath" Type="string"
          Value="&quot;[GUIFOLDER]detec-agent-gui.exe&quot;" />
        <RegistryValue Name="Version" Type="string" Value="1,0,0" />
      </RegistryKey>
    </Component>

    <!--
      Custom Actions use schtasks.exe directly to avoid PyInstaller startup
      issues during MSI deferred execution.
      The agent self-configures from the MSI trailer on first start
      (see _try_extract_installer_config in agent_cli.py).
    -->

    <!--
      Custom Actions: Register/unregister Scheduled Task.
      Uses immediate-execute (runs as the installing user, who is admin for
      per-machine MSI installs). Hardcodes the known install path because
      deferred CAs cannot resolve MSI properties.
      The agent self-configures from the MSI trailer on first start.
    -->
    <CustomAction Id="RegisterTask"
      Directory="AGENTFOLDER"
      ExeCommand="schtasks.exe /create /tn DetecAgent /tr &quot;'C:\Program Files\Detec\Agent\detec-agent.exe' run&quot; /sc onstart /ru SYSTEM /rl HIGHEST /f"
      Execute="immediate"
      Return="check" />

    <CustomAction Id="StartTask"
      Directory="AGENTFOLDER"
      ExeCommand='schtasks.exe /run /tn "DetecAgent"'
      Execute="immediate"
      Return="ignore" />

    <CustomAction Id="StopTask"
      Directory="AGENTFOLDER"
      ExeCommand='schtasks.exe /end /tn "DetecAgent"'
      Execute="immediate"
      Return="ignore" />

    <CustomAction Id="DeleteTask"
      Directory="AGENTFOLDER"
      ExeCommand='schtasks.exe /delete /tn "DetecAgent" /f'
      Execute="immediate"
      Return="ignore" />

    <CustomAction Id="RegisterWatchdog"
      Directory="AGENTFOLDER"
      ExeCommand="schtasks.exe /create /tn DetecAgentWatchdog /tr &quot;'C:\Program Files\Detec\Agent\detec-agent.exe' watchdog&quot; /sc onstart /ru SYSTEM /rl HIGHEST /f"
      Execute="immediate"
      Return="check" />

    <CustomAction Id="StartWatchdog"
      Directory="AGENTFOLDER"
      ExeCommand='schtasks.exe /run /tn DetecAgentWatchdog'
      Execute="immediate"
      Return="ignore" />

    <CustomAction Id="StopWatchdog"
      Directory="AGENTFOLDER"
      ExeCommand='schtasks.exe /end /tn DetecAgentWatchdog'
      Execute="immediate"
      Return="ignore" />

    <CustomAction Id="DeleteWatchdog"
      Directory="AGENTFOLDER"
      ExeCommand='schtasks.exe /delete /tn DetecAgentWatchdog /f'
      Execute="immediate"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterTask" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE" />
      <Custom Action="StartTask" After="RegisterTask" Condition="NOT Installed AND NOT REMOVE" />
      <Custom Action="RegisterWatchdog" After="StartTask" Condition="NOT Installed AND NOT REMOVE" />
      <Custom Action="StartWatchdog" After="RegisterWatchdog" Condition="NOT Installed AND NOT REMOVE" />
      <Custom Action="StopWatchdog" Before="InstallValidate" Condition='REMOVE="ALL"' />
      <Custom Action="DeleteWatchdog" After="StopWatchdog" Condition='REMOVE="ALL"' />
      <Custom Action="StopTask" After="DeleteWatchdog" Condition='REMOVE="ALL"' />
      <Custom Action="DeleteTask" After="StopTask" Condition='REMOVE="ALL"' />
    </InstallExecuteSequence>

    <Feature Id="Complete" Level="1">
      <!-- Explicit components -->
      <ComponentRef Id="AgentExe" />
      <ComponentRef Id="GuiExe" />
      <ComponentRef Id="BrandingFiles" />
      <ComponentRef Id="AgentDataDir" />
      <ComponentRef Id="ActiveSetupTray" />
      <!-- Harvested _internal directories (generated by wix heat) -->
      <ComponentGroupRef Id="AgentInternalFiles" />
      <ComponentGroupRef Id="GuiInternalFiles" />
    </Feature>

  </Package>
</Wix>
