__pycache__/
*.pyc
.DS_Store
*.ndjson
.env
.env.local
.env.*.local
dashboard/dist/
node_modules/
.venv/
*.egg-info/
*.psd

# Real collector config (may contain api_key)
collector/config/collector.json

# Agent and server env files (may contain API keys / secrets)
agent.env
server.env
**/agent.env
**/server.env
seed-credentials.txt

# Credential and key file patterns
*.pem
*.key
*.p12
*.pfx

# Generated installer assets (built by generate-assets.py)
installers/windows/installer/*.bmp

# PyInstaller build artifacts
installers/windows/build/
installers/windows/dist/
installers/macos/build/
installers/macos/dist/

# Evasion suite metrics (CI artifact)
evasion_metrics.json

# Root build and distributable output
build/
dist/

# Baked into Docker API image at build time (do not commit installers)
docker/default-agent-packages/*
!docker/default-agent-packages/README.md

# Compiled native binaries
# Note: esf_helper universal binary IS committed to the repo (see build-esf-helper.yml
# which builds arm64+x86_64 and commits the fat binary back on push to main).
# The gitignore exception below allows the CI-committed binary to be tracked.
# collector/providers/esf_helper/esf_helper  ← intentionally not ignored

# Claude Code IDE config
.claude/

# Pytest cache
.pytest_cache/

# Logs
agent.log
api/server.log

# Build artifacts
branding/capability-brief.html
branding/capability-brief.pdf

# Cursor workspace (agent commands, rules, plans — not project-specific)
.cursor/

# Sensitive internal docs
docs/ciso-security-log.md

# Aider
.aider*

# Sprint/session artifacts
lab-runs/
project-tasks/
project-specs/
project-docs/

# VSCode local settings
.vscode/
