FROM python:3.11-slim

WORKDIR /app

COPY api/requirements.txt api/requirements.lock* ./
RUN pip install --no-cache-dir -r $([ -f requirements.lock ] && echo requirements.lock || echo requirements.txt)

COPY api/ .
COPY protocol/ ./protocol/
COPY dashboard/dist ./dashboard/dist

RUN chmod +x entrypoint.sh

RUN adduser --disabled-password --no-create-home --gecos "" appuser
# Agent download payloads: copy before switching to appuser (see docker/default-agent-packages/README.md)
RUN mkdir -p /data/packages
COPY docker/default-agent-packages/ /data/packages/
RUN chown -R appuser:appuser /data/packages
USER appuser

EXPOSE 8000

ENTRYPOINT ["./entrypoint.sh"]
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
